# 1 = deterministic offline fixture; 0 = live OpenCode/project state.
BIEXCE_DASHBOARD_MOCK=1
BIEXCE_DASHBOARD_PORT=8090
BIEXCE_DASHBOARD_POLL=2.0

# Live OpenCode collector on the same machine or a trusted private network.
OPENCODE_SERVE_URL=http://127.0.0.1:4096
BIEXCE_MACHINE_NAME=dev-01
BIEXCE_SESSION_LIMIT=100

# Project roots separated by the OS path separator.
# Windows: D:\work\project-a;D:\work\project-b
# Linux/macOS: /work/project-a:/work/project-b
BIEXCE_PROJECT_ROOTS=

# Optional configured-model source. Default: ~/.config/biexce/model-routing.json
BIEXCE_ROUTING_FILE=
