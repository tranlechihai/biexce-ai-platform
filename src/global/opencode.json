{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "bx-code",
  "subagent_depth": 1,
  "share": "disabled",
  "provider": {
    "biexce-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Biexce Local",
      "options": {
        "baseURL": "{env:BIEXCE_LOCAL_BASE_URL}"
      },
      "models": {
        "vllm/Qwen/Qwen3.6-27B-FP8": {
          "name": "Biexce Qwen3.6 27B Local",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.pfx": "deny",
      "*.p12": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "*.mobileprovision": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.npmrc": "deny",
      "*.pypirc": "deny",
      "*.netrc": "deny",
      "*secrets*.yaml": "deny",
      "*secrets*.yml": "deny",
      "*credentials*.json": "deny",
      "*service-account*.json": "deny",
      "*google-services.json": "deny",
      "*GoogleService-Info.plist": "deny",
      "*gradle.properties": "deny",
      "*.tfvars": "deny",
      "*.tfvars.json": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "edit": "ask",
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "bash": {
      "*": "ask",
      "git status --short": "allow",
      "git status --short --branch": "allow",
      "git diff --no-ext-diff --no-textconv": "allow",
      "git diff --no-ext-diff --no-textconv --cached": "allow",
      "git log -n 20 --oneline --decorate": "allow",
      "git add*": "deny",
      "git * add*": "deny",
      "git commit*": "deny",
      "git * commit*": "deny",
      "git push*": "deny",
      "git * push*": "deny",
      "git pull*": "deny",
      "git * pull*": "deny",
      "git fetch*": "deny",
      "git * fetch*": "deny",
      "git reset*": "deny",
      "git * reset*": "deny",
      "git clean*": "deny",
      "git * clean*": "deny",
      "git restore*": "deny",
      "git * restore*": "deny",
      "git checkout*": "deny",
      "git * checkout*": "deny",
      "git switch*": "deny",
      "git * switch*": "deny",
      "git merge*": "deny",
      "git * merge*": "deny",
      "git rebase*": "deny",
      "git * rebase*": "deny",
      "git cherry-pick*": "deny",
      "git * cherry-pick*": "deny",
      "git revert*": "deny",
      "git * revert*": "deny",
      "git stash*": "deny",
      "git * stash*": "deny",
      "git branch*": "deny",
      "git * branch*": "deny",
      "git tag*": "deny",
      "git * tag*": "deny",
      "git apply*": "deny",
      "git * apply*": "deny",
      "git am*": "deny",
      "git * am*": "deny",
      "git worktree*": "deny",
      "git * worktree*": "deny",
      "git rm*": "deny",
      "git * rm*": "deny",
      "git mv*": "deny",
      "git * mv*": "deny",
      "git remote*": "deny",
      "git * remote*": "deny",
      "git config*": "deny",
      "git * config*": "deny",
      "git update-ref*": "deny",
      "git * update-ref*": "deny",
      "git symbolic-ref*": "deny",
      "git * symbolic-ref*": "deny",
      "git notes*": "deny",
      "git * notes*": "deny",
      "git replace*": "deny",
      "git * replace*": "deny",
      "git submodule*": "deny",
      "git * submodule*": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "rd *": "deny",
      "Remove-Item *": "deny",
      "kubectl *": "deny",
      "helm *": "deny",
      "aws *": "deny",
      "az *": "deny",
      "gcloud *": "deny",
      "terraform apply*": "deny",
      "terraform destroy*": "deny",
      "tofu apply*": "deny",
      "tofu destroy*": "deny",
      "docker push*": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "yarn npm publish*": "deny",
      "dotnet nuget push*": "deny",
      "nuget push*": "deny",
      "gh release*": "deny",
      "vercel *": "deny",
      "netlify *": "deny",
      "firebase deploy*": "deny",
      "fastlane *": "deny"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      "Build/**",
      "Builds/**",
      "Library/**",
      "Temp/**",
      "Logs/**",
      "obj/**",
      "bin/**",
      ".gradle/**",
      "DerivedData/**",
      "Pods/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      "target/**"
    ]
  }
}
