{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biexce.local/runtime/session-registry-v1.schema.json",
  "title": "BIEXCE Runtime Session Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "project_root",
    "revision",
    "sessions",
    "updated_at_utc"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.biexce.local/runtime/session-registry-v1.schema.json"
    },
    "schema_version": { "const": 1 },
    "project_root": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "sessions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^job-[A-Za-z0-9._-]{1,180}$"
      },
      "additionalProperties": { "$ref": "#/$defs/session" }
    },
    "updated_at_utc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "session_id",
        "parent_session_id",
        "agent",
        "model",
        "status",
        "attempt",
        "created_at_utc",
        "updated_at_utc",
        "last_error"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^job-[A-Za-z0-9._-]{1,180}$"
        },
        "session_id": { "type": "string", "minLength": 1 },
        "parent_session_id": { "type": "string", "minLength": 1 },
        "agent": { "type": "string", "minLength": 1 },
        "model": {
          "type": "string",
          "pattern": "^[^/]+/.+$"
        },
        "status": {
          "enum": [
            "ACTIVE",
            "RETRYING",
            "COMPLETED",
            "CANCELLED",
            "FAILED"
          ]
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "created_at_utc": { "type": "string", "format": "date-time" },
        "updated_at_utc": { "type": "string", "format": "date-time" },
        "last_error": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
