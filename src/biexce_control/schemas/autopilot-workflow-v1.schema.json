{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biexce.local/control-plane/autopilot-workflow-v1.schema.json",
  "title": "BIEXCE Autopilot Workflow State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "project_root", "phase", "revision",
    "current_task_id", "plan_revision", "fix_round", "gate_1",
    "gate_1_approved_by", "gate_1_approved_at_utc", "gate_2",
    "gate_2_approved_by", "gate_2_approved_at_utc", "last_agent",
    "last_result", "blocked_reason", "updated_at_utc", "updated_by"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.biexce.local/control-plane/autopilot-workflow-v1.schema.json"
    },
    "schema_version": { "const": 1 },
    "project_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "phase": {
      "enum": [
        "EXPLORE", "PLAN", "PLAN_REVIEW", "WAITING_GATE_1", "CODE",
        "TEST", "FIX", "TASK_REVIEW", "INTEGRATION_TEST", "INTEGRATION_FIX",
        "INTEGRATION_REVIEW", "WAITING_GATE_2", "COMPLETE", "BLOCKED"
      ]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "current_task_id": {
      "type": ["string", "null"],
      "pattern": "^t-[0-9]{3}$"
    },
    "plan_revision": { "type": "integer", "minimum": 0, "maximum": 2 },
    "fix_round": { "type": "integer", "minimum": 0, "maximum": 3 },
    "gate_1": { "enum": ["PENDING", "APPROVED"] },
    "gate_1_approved_by": { "type": ["string", "null"], "maxLength": 256 },
    "gate_1_approved_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "gate_2": { "enum": ["PENDING", "APPROVED"] },
    "gate_2_approved_by": { "type": ["string", "null"], "maxLength": 256 },
    "gate_2_approved_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "last_agent": { "type": ["string", "null"], "maxLength": 64 },
    "last_result": { "type": ["string", "null"], "maxLength": 128 },
    "blocked_reason": { "type": ["string", "null"], "maxLength": 1000 },
    "updated_at_utc": { "type": "string", "format": "date-time", "maxLength": 64 },
    "updated_by": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
