{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biexce.local/runtime/agent-result-v1.schema.json",
  "title": "BIEXCE Agent Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "workflow_revision", "phase", "task_id",
    "agent", "status", "summary", "changed_files", "checks", "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.biexce.local/runtime/agent-result-v1.schema.json"
    },
    "schema_version": { "const": 1 },
    "workflow_revision": { "type": "integer", "minimum": 1 },
    "phase": {
      "enum": [
        "EXPLORE", "PLAN", "PLAN_REVIEW", "CODE", "TEST", "FIX",
        "TASK_REVIEW", "INTEGRATION_TEST", "INTEGRATION_FIX", "INTEGRATION_REVIEW"
      ]
    },
    "task_id": { "type": ["string", "null"], "pattern": "^t-[0-9]{3}$" },
    "agent": {
      "enum": ["bx-plan", "bx-explore", "bx-code", "bx-fix", "bx-test", "bx-review"]
    },
    "status": {
      "enum": [
        "SUCCEEDED", "FAILED", "PASS", "FAIL", "INCONCLUSIVE", "PLAN_OK",
        "PLAN_NEEDS_REVISION", "APPROVE", "APPROVE_WITH_MINOR_NOTES",
        "CHANGES_REQUIRED"
      ]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "changed_files": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "checks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "status", "output_summary"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "exit_code": { "type": ["integer", "null"] },
          "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
          "output_summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    }
  }
}
